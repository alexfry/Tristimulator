<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <key>NSExtension</key>
    <dict>
        <key>NSExtensionAttributes</key>
        <dict>
            <key>QLSupportedContentTypes</key>
            <array>
                <string>com.ilm.openexr-image</string>
            </array>
            <!-- QLIsDataBasedPreview = false → QL calls preparePreviewOfFile(at:) with a URL,
                 not preparePreviewOfFile(forItemAt:contentType:options:completionHandler:).
                 We need the file URL so we can read the binary EXR header for colour space metadata. -->
            <key>QLIsDataBasedPreview</key>
            <false/>
        </dict>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.quicklook.preview</string>
        <key>NSExtensionPrincipalClass</key>
        <string>$(PRODUCT_MODULE_NAME).PreviewViewController</string>
    </dict>

    <!-- The UTI for EXR is declared (and owned) by the main Tristimulator target.
         The extension does not redeclare it; Launch Services finds it via the host app. -->

</dict>
</plist>
