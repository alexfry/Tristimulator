<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App extensions must be sandboxed or macOS will not load them. This
         matches ENABLE_APP_SANDBOX = YES in the Xcode target; the release
         script signs the appex with this file. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Read-only access to the file being previewed. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>

    <!-- Hardened runtime is ON (set in build settings); no library validation
         waiver needed because we have no third-party dylibs in the extension. -->
</dict>
</plist>
