<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox off: required to load a pre-compiled .metallib from the bundle
         and to call makeLibrary(data:) without entitlement restrictions. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Read-only access to the file being previewed. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>

    <!-- Hardened runtime is ON (set in build settings); no library validation
         waiver needed because we have no third-party dylibs in the extension. -->
</dict>
</plist>
