  Group {
   inputs 0
   name VignetteExpression5
   tile_color 0xffff
   xpos -832
   ypos -181
   addUserKnob {20 controls l Controls}
   addUserKnob {7 x R 0 10}
   x 0.25
   addUserKnob {7 y R 0 10}
   y 0.8
   addUserKnob {26 ""}
   addUserKnob {26 help_txt l "" +STARTLINE T "Creates a Vignette mask using expressions.\n\nConfused? Ping me at peyap@ilm.com\n2023"}
  }
   Expression {
    inputs 0
    temp_name0 b
    temp_expr0 (width/2)
    temp_name1 a
    temp_expr1 (height/2)
    temp_name2 c
    temp_expr2 parent.y
    temp_name3 d
    temp_expr3 parent.x
    expr0 "((height/2) - sqrt( ((d*(x-b)) * (d*(x-b))) + ((c*(y-a)) * (c*(y-a))) ) ) / (height/2) "
    channel3 rgb
    name VignetteExpression
    xpos -350
    ypos 397
   }
   Shuffle {
    green red
    blue red
    alpha red
    name Shuffle1
    label "\[value in]-->\[value out]"
    xpos -350
    ypos 445
   }
   Output {
    name Output1
    xpos -350
    ypos 505
   }
  end_group
  Grade {
   channels alpha
   gamma 1.3
   white_clamp true
   name Grade32
   xpos -832
   ypos -124
  }
