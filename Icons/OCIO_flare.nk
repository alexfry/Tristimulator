  addUserKnob {20 KernelProfile}
  addUserKnob {22 update l "Refresh kernel menu" t "# iterate through folders and files\nfor dirpath, dirnames, filenames in os.walk(rootdir):\n    # filter by extension and remove it from filename\n    filenames = \[ fi for fi in filenames if fi.endswith(\".nk\") ]\n    filenames = \[ os.path.splitext(i)\[0] for i in filenames  ]\n    # print filenames\n    # create dictionary \{pulldown choice: path\}\n    for filename in filenames:\n        full = os.path.join(dirpath, filename)\n        last =  os.path.relpath(full, rootdir)\n        pulldown_dict\[last] = full\n# print pulldown_dict\n\n----------------\n\n# iterate through folders and files\nfor dirpath, dirnames, filenames in os.walk(rootdir):\n    # filter by extension and remove it from filename\n    filenames = \[ fi for fi in filenames if fi.endswith(\".nk\") ]\n    filenames = \[ os.path.splitext(i)\[0] for i in filenames  ]\n    # print filenames\n    # create dictionary \{pulldown choice: path\}\n    for filename in filenames:\n        full = os.path.join(dirpath, filename)\n        full = full.replace(\"profiles/\",\"\")\n        if \"versions/\" not in full:\n            last = os.path.relpath(full, rootdir)\n            pulldown_dict\[last] = full\n\n# print pulldown_dict" -STARTLINE T "import os\n\n# main kernel profile location\nrootdir = '/show/shared/comp/kernel_profile/'\nnode = nuke.thisNode()\n\nshowlist = os.listdir(rootdir)\nshowlist = sorted(showlist)\n\nnode\['show'].setValues(showlist)\n\n\npulldown_dict = \{\}\n\n# iterate through folders and files\nfor dirpath, dirnames, filenames in os.walk(rootdir):\n    # filter by extension and remove it from filename\n    filenames = \[ fi for fi in filenames if fi.endswith(\".nk\") ]\n    filenames = \[ os.path.splitext(i)\[0] for i in filenames  ]\n    # print filenames\n    # create dictionary \{pulldown choice: path\}\n    for filename in filenames:\n        full = os.path.join(dirpath, filename)\n        full = full.replace(\"profiles/\",\"\")\n        if \"versions/\" not in full:\n            last = os.path.relpath(full, rootdir)\n            pulldown_dict\[last] = full\n\n# print pulldown_dict\n\n# get a list for nuke cascading knob\npulldown_choices = list(pulldown_dict.keys())\npulldown_choices = sorted(pulldown_choices)\nprint pulldown_choices\n# set knob values\nnode\['krnl'].setValues(pulldown_choices)\nnode\['kerneldict'].setValue(str(pulldown_dict))\n\nprint 'Kernels updated'"}
  addUserKnob {26 kerneldict l "" +STARTLINE +INVISIBLE T "\{'_generic/lens/40_G_A-116': '/show/shared/comp/kernel_profile/_generic/lens/40_G_A-116', 'trixie/creative/GodraysChroma': '/show/shared/comp/kernel_profile/trixie/creative/GodraysChroma', 'sunlit/shot/trl0090': '/show/shared/comp/kernel_profile/sunlit/shot/trl0090', 'sunlit/lens/SPH_15-40_PZW_A-119': '/show/shared/comp/kernel_profile/sunlit/lens/SPH_15-40_PZW_A-119', 'sunlit/shot/cow1500': '/show/shared/comp/kernel_profile/sunlit/shot/cow1500', 'sunlit/lens/40_G_A-116': '/show/shared/comp/kernel_profile/sunlit/lens/40_G_A-116', 'trixie/lens/18mm_ZEISSMP_f2.8': '/show/shared/comp/kernel_profile/trixie/lens/18mm_ZEISSMP_f2.8', 'trixie/lens/40mm_ZEISSMP_f4.0': '/show/shared/comp/kernel_profile/trixie/lens/40mm_ZEISSMP_f4.0', '_generic/creative/GodraysMovingSpikes': '/show/shared/comp/kernel_profile/_generic/creative/GodraysMovingSpikes', 'sunlit/asset/GenieTailGlitter': '/show/shared/comp/kernel_profile/sunlit/asset/GenieTailGlitter', 'sunlit/creative/Glint5': '/show/shared/comp/kernel_profile/sunlit/creative/Glint5', '_generic/lens/SPH_15-40_PZW_A-119': '/show/shared/comp/kernel_profile/_generic/lens/SPH_15-40_PZW_A-119', 'trixie/lens/40mm_ZEISSMP_f2.0': '/show/shared/comp/kernel_profile/trixie/lens/40mm_ZEISSMP_f2.0', '_generic/creative/GodraysChroma': '/show/shared/comp/kernel_profile/_generic/creative/GodraysChroma', 'sunlit/creative/RandomStars': '/show/shared/comp/kernel_profile/sunlit/creative/RandomStars', 'sunlit/creative/MovingSpikes': '/show/shared/comp/kernel_profile/sunlit/creative/MovingSpikes', 'sunlit/creative/GodraysChroma': '/show/shared/comp/kernel_profile/sunlit/creative/GodraysChroma', 'sunlit/creative/GodraysMovingSpikes': '/show/shared/comp/kernel_profile/sunlit/creative/GodraysMovingSpikes'\}"}
  addUserKnob {26 ""}
  addUserKnob {4 show M {_generic sunlit trixie}}
  show sunlit
  addUserKnob {22 play l preview -STARTLINE T "import os\nrootdir = '/show/shared/comp/kernel_profile/'\nnode = nuke.thisNode()\nshow = node\[\"show\"].value()\npath = rootdir + show + \"/previews\"\npath_exists = False\nif os.path.exists(path):\n    if len(os.listdir(path) ) > 0:\n        path_exists = True\nif path_exists:\n    cmd = 'rv ' + path + '&'\n    os.system(cmd)\nelse:\n    print \"no examples exist\""}
  addUserKnob {22 playall l "preview All" -STARTLINE T "\nimport os\nrootdir = '/show/shared/comp/kernel_profile/'\nnode = nuke.thisNode()\nshows = node\[\"show\"].values()\npaths = \[]\nfor i in shows:\n    path = rootdir + i + \"/previews\"\n    if os.path.exists(path):\n        if len(os.listdir(path) ) > 0:\n            paths.append(path)\nrv_path = ' '.join(paths)\ncmd = 'rv ' + rv_path + '&'\nos.system(cmd)"}
  addUserKnob {26 ""}
  addUserKnob {68 krnl l kernel M {_generic/creative/GodraysChroma _generic/creative/GodraysMovingSpikes _generic/lens/40_G_A-116 _generic/lens/SPH_15-40_PZW_A-119 sunlit/asset/GenieTailGlitter sunlit/creative/Glint5 sunlit/creative/GodraysChroma sunlit/creative/GodraysMovingSpikes sunlit/creative/MovingSpikes sunlit/creative/RandomStars sunlit/lens/40_G_A-116 sunlit/lens/SPH_15-40_PZW_A-119 sunlit/shot/cow1500 sunlit/shot/trl0090 trixie/creative/GodraysChroma trixie/lens/18mm_ZEISSMP_f2.8 trixie/lens/40mm_ZEISSMP_f2.0 trixie/lens/40mm_ZEISSMP_f4.0}}
  krnl sunlit/asset/GenieTailGlitter
  addUserKnob {22 pyset l "Set " -STARTLINE T "import ast\n\nnode = nuke.thisNode()\n# transform string to dict\npull_dict = ast.literal_eval(node\['kerneldict'].value())\n# get current knob selection\nval = node\['krnl'].value()\n\nto_paste = pull_dict\[val] + '.nk'\nto_paste = to_paste.split(\"/\")\nto_paste.insert(6, 'profiles')\nto_paste = str(\"/\").join(to_paste)\n\n\nwith nuke.thisNode():\n    # get output node and position\n    for i in nuke.allNodes('Output'):\n        output_node = nuke.toNode(i.name())\n        out_xpos, out_ypos = i\['xpos'].value(), i\['ypos'].value()\n        break\n\n    # delete everything except the output node\n    for i in nuke.allNodes():\n        if i.Class() == 'Output':\n            i\['selected'].setValue(False)\n        else:\n            i\['selected'].setValue(True)\n    nukescripts.node_delete()\n\n    # paste profile\n    nuke.nodePaste(to_paste)\n\n    # get offset from new nodes to output node\n    output_kernel = None\n    for i in nuke.selectedNodes():\n\n        if 'kernel_txt' in i.knobs().keys():\n            output_kernel = nuke.toNode(i.name())\n            current_xpos, current_ypos = i\['xpos'].value(), i\['ypos'].value()\n\n            new_xpos = out_xpos+35\n            new_ypos = ( i\['ypos'].value() + (out_ypos -i\['ypos'].value()) )-200\n\n            offset_xpos = new_xpos - current_xpos\n            offset_ypos = new_ypos - current_ypos\n\n            break\n\n\n    # move nodes\n    if output_kernel != None:\n        for i in nuke.selectedNodes():\n            x_val = i\['xpos'].value()\n            y_val = i\['ypos'].value()\n            i\['xpos'].setValue(x_val+offset_xpos)\n            i\['ypos'].setValue(y_val+offset_ypos)\n\n        # connect nodes\n        output_node.setInput(0,output_kernel)\n\n        print 'Kernel set to ' + str(val)\n    else:\n        print 'Output Kernel Dot not found'\n"}
  addUserKnob {26 ""}
  addUserKnob {26 version l "" +STARTLINE T "Kernel Profile v0.7.1"}
 }
