push $N2df8f010
 Group {
  name simpleDisc_10_opti
  tile_color 0xffff
  xpos 5309
  ypos 2615
  addUserKnob {20 mainCTRLS l Controls}
  addUserKnob {7 inverseScale l "Inverse Scale" t "Math product from the center of frame. You may go to a positive scale to create some interesting looks." R -1 1}
  inverseScale -1
  addUserKnob {7 squeezefactor l "Squeeze Factor" R 0.01 2}
  squeezefactor 1
  addUserKnob {26 ""}
  addUserKnob {41 scale l "Overall Scale" T scaleTransform.scale}
  addUserKnob {41 scale_7 l "Additional Scale" T additionalscale.scale}
  addUserKnob {26 ""}
  addUserKnob {41 size l "Overall Blur" T Blur8.size}
  addUserKnob {41 white l "Overall gain" T Grade39.white}
  addUserKnob {41 multiply l "Overall Colour" T Grade39.multiply}
  addUserKnob {26 ""}
  addUserKnob {6 vAlpha l "View Vignette Alpha" +STARTLINE}
  addUserKnob {6 stencilMain l "Stencil Main" -STARTLINE}
  addUserKnob {6 stencilH l "Stencil Hoop/Hollow" -STARTLINE}
  stencilH true
  addUserKnob {26 "" -STARTLINE}
  addUserKnob {41 x l "Vignette x" T VignetteExpression5.x}
  addUserKnob {41 y l "Vignette y" T VignetteExpression5.y}
  addUserKnob {41 gamma T Grade32.gamma}
  addUserKnob {41 blackpoint T Grade32.blackpoint}
  addUserKnob {41 whitepoint T Grade32.whitepoint}
  addUserKnob {41 size_1 l "<b>Hoop/Hollow Blur</b>" T Blur1.size}
  addUserKnob {26 hoop_txt l <b>Hoop</b>}
  addUserKnob {7 scaleOffset l Offset t "Offsets hoop scale with overall scale"}
  scaleOffset 0.03
  addUserKnob {41 scale_6 l scale T scaleTransform1.scale}
  addUserKnob {41 disable_7 l disable -STARTLINE T Merge1.disable}
  addUserKnob {26 hollow_txt l <b>Hollow</b>}
  addUserKnob {41 multiply_1 l Colour T Grade33.multiply}
  addUserKnob {41 disable_8 l disable -STARTLINE T Plus.disable}
  addUserKnob {26 ""}
  addUserKnob {26 rainbow_txt l "<b>Primary Chroma</b>"}
  addUserKnob {41 scale_8 l "scale Red" T Transform1.scale}
  addUserKnob {41 disable_9 l disable -STARTLINE T Transform1.disable}
  addUserKnob {41 scale_1 l "scale Green" T Transform29.scale}
  addUserKnob {41 disable_1 l disable -STARTLINE T Transform29.disable}
  addUserKnob {41 scale_2 l "scale Blue" T Transform30.scale}
  addUserKnob {41 disable_2 l disable -STARTLINE T Transform30.disable}
  addUserKnob {26 ""}
  addUserKnob {26 ""}
  addUserKnob {26 _1 l "" +STARTLINE T "Helps create individual IBF elements.\n\nConfused? Ping me at peyap@ilm.com\n2023"}
 }
