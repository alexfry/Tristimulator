724701, 161.738754, 162.752808, 163.766861, 164.780914, 165.794968, 166.809006, 167.823059, 168.837112, 169.851166, 170.865219, 171.879272, 172.893311, 173.907364, 174.921417, 175.935471, 176.949524, 177.963562, 178.977615, 179.991669, 181.005722, 182.019775, 183.033829, 184.047867, 185.06192, 186.075974, 187.090027, 188.10408, 189.118118, 190.132172, 191.146225, 192.160278, 192.967346, 193.774429, 194.581497, 195.585892, 196.590271, 197.594666, 198.59906, 199.603439, 200.607834, 201.612228, 202.616608, 203.621002, 204.625397, 205.629776, 206.634171, 207.638565, 208.642944, 209.647339, 210.651733, 211.656113, 212.660507, 213.664886, 214.669281, 215.673676, 216.678055, 217.682449, 218.686844, 219.691223, 220.695618, 221.700012, 222.704391, 223.708786, 224.713181, 225.71756, 226.721954, 227.726349, 228.730728, 229.735123, 230.739517, 231.743896, 232.748291, 233.752686, 234.757065, 235.761459, 236.765854, 237.770233, 238.774628, 239.779022, 240.783401, 241.787796, 242.792175, 243.79657, 244.800964, 245.805344, 246.809738, 247.814133, 248.818512, 249.822906, 250.827301, 251.83168, 252.836075, 253.840469, 254.844849, 255.849243, 256.853638, 257.858032, 258.862427, 259.866791, 260.871185, 261.87558, 262.879974, 263.884369, 264.888733, 265.893127, 266.897522, 267.890747, 268.883972, 269.877228, 270.870453, 271.863678, 272.856903, 273.850159, 274.843384, 275.836609, 276.843658, 277.850739, 278.857788, 279.864868, 280.871918, 281.878998, 282.886047, 283.893127, 284.900177, 285.907257, 286.914307, 287.921387, 288.928436, 289.935516, 290.942566, 291.949615, 292.956696, 293.963745, 294.970825, 295.977875, 296.984955, 297.992004, 298.999084, 300.006134, 301.013214, 302.020264, 303.027344, 304.034393, 305.041443, 306.048523, 307.055573, 308.062653, 309.069702, 310.076782, 311.083832, 312.090912, 313.097961, 314.105042, 315.112091, 316.119171, 317.126221, 318.133301, 319.14035, 320.1474, 321.15448, 322.16153, 323.16861, 324.175659, 325.182739, 326.189789, 327.196869, 328.203918, 329.210999, 330.218048, 331.225128, 332.232178, 333.239227, 334.246307, 335.253357, 336.260437, 337.204651, 338.148834, 339.093018, 340.037231, 340.981445, 341.925629, 342.929749, 343.933899, 344.938019, 345.942169, 346.946289, 347.950409, 348.954559, 349.958679, 350.96283, 351.966949, 352.971069, 353.97522, 354.97934, 355.983459, 356.98761, 357.99173, 358.99588, 360.};
float3 ocio_gamut_cusp_table_0_sample(float h)
{
  int i = int(h) + 1;
  int i_lo = int(max(float(0), float(i + 0)));
  int i_hi = int(min(float(361), float(i + 2)));
  while (i_lo + 1 < i_hi)
  {
    float hcur = ocio_gamut_cusp_table_0_hues_array[i];
    if (h > hcur)
    {
      i_lo = i;
    }
    else
    {
      i_hi = i;
    }
    i = (i_lo + i_hi) / 2;
  }
  float3 lo = ocio_gamut_cusp_table_0.sample(ocio_gamut_cusp_table_0Sampler, (i_hi - 1 + 0.5) / 362).rgb;
  float3 hi = ocio_gamut_cusp_table_0.sample(ocio_gamut_cusp_table_0Sampler, (i_hi + 0.5) / 362).rgb;
  float t = (h - ocio_gamut_cusp_table_0_hues_array[i_hi - 1]) / (ocio_gamut_cusp_table_0_hues_array[i_hi] - ocio_gamut_cusp_table_0_hues_array[i_hi - 1]);
  return mix(lo, hi, t);
}
float ocio_get_focus_gain0(float J, float cuspJ)
{
  float thr = mix(cuspJ, 283.249878, 0.300000);
  if (J > thr)
  {
    float gain = ( 283.249878 - thr) / max(0.0001, 283.249878 - J);
    gain = log(gain)/log(10.0);
    return gain * gain + 1.0;
  }
  else
  {
    return 1.0;
  }
}
float ocio_solve_J_intersect0(float J, float M, float focusJ, float slope_gain)
{
  float M_scaled = M / slope_gain;
  float a = M_scaled / focusJ;
  if (J < focusJ)
  {
    float b = 1.0 - M_scaled;
    float c = -J;
    float det =  b * b - 4.f * a * c;
    float root =  sqrt(det);
    return -2.0 * c / (b + root);
  }
  else
  {
    float b = - (1.0 + M_scaled + 283.249878 * a);
    float c = 283.249878 * M_scaled + J;
    float det =  b * b - 4.f * a * c;
    float root =  sqrt(det);
    return -2.0 * c / (b - root);
  }
}
float ocio_find_gamut_boundary_intersection0(float2 JM_cusp, float gamma_top_inv, float gamma_bottom_inv, float J_intersect_source, float J_intersect_cusp, float slope)
{
  float M_boundary_lower = J_intersect_cusp * pow(J_intersect_source / J_intersect_cusp, gamma_bottom_inv) / (JM_cusp.r / JM_cusp.g - slope);
  float M_boundary_upper = JM_cusp.g * (283.249878 - J_intersect_cusp) * pow((283.249878 - J_intersect_source) / (283.249878 - J_intersect_cusp), gamma_top_inv) / (slope * JM_cusp.g + 283.249878 - JM_cusp.r);
  float smin = 0.0;
  {
    float a = M_boundary_lower;
    float b = M_boundary_upper;
    float s = 0.119999997 * JM_cusp.g;
    float h = max(s - abs(a - b), 0.0) / s;
    smin = min(a, b) - h * h * h * s * 0.16666666666666666;
  }
  return smin;
}
float ocio_remap_M_fwd0(float M, float gamut_boundary_M, float reach_boundary_M)
{
  float boundary_ratio = gamut_boundary_M / reach_boundary_M;
  float proportion = max(boundary_ratio, 0.75);
  float threshold = proportion * gamut_boundary_M;
  if (proportion >= 1.0f || M <= threshold)
  {
    return M;
  }
  float m_offset = M - threshold;
  float gamut_offset = gamut_boundary_M - threshold;
  float reach_offset = reach_boundary_M - threshold;
  float scale = reach_offset / ((reach_offset / gamut_offset) - 1.0f);
  float nd = m_offset / scale;
  return threshold + scale * nd / (1.0f + nd);
}
float3 ocio_gamut_compress0(float3 JMh, float Jx, float3 JMGcusp, float reachMaxM)
{
  float J = JMh.r;
  float M = JMh.g;
  float h = JMh.b;
  if (M <= 0.0 || J > 283.249878)
  {
    return float3(J, 0.0, h);
  }
  else
  {
    float2 JMcusp = JMGcusp.rg;
    float focusJ = mix(JMcusp.r, 40.816883, min(1.0, 1.300000 - (JMcusp.r / 283.249878)));
    float slope_gain = 1051.56519 * ocio_get_focus_gain0(Jx, JMcusp.r);
    float J_intersect_source = ocio_solve_J_intersect0(JMh.r, JMh.g, focusJ, slope_gain);
    float gamut_slope = (J_intersect_source < focusJ) ? J_intersect_source : (283.249878 - J_intersect_source);
    gamut_slope = gamut_slope * (J_intersect_source - focusJ) / (focusJ * slope_gain);
    float gamma_top_inv = JMGcusp.b;
    float gamma_bottom_inv = 0.826446235;
    float J_intersect_cusp = ocio_solve_J_intersect0(JMcusp.r, JMcusp.g, focusJ, slope_gain);
    float gamutBoundaryM = ocio_find_gamut_boundary_intersection0(JMcusp, gamma_top_inv, gamma_bottom_inv, J_intersect_source, J_intersect_cusp, gamut_slope);
    if (gamutBoundaryM <= 0.0)
    {
      return float3(J, 0.0, h);
    }
    float reachBoundaryM = 283.249878 * pow(J_intersect_source / 283.249878,  0.879464149);
    reachBoundaryM = reachBoundaryM / ((283.249878 / reachMaxM) - gamut_slope);
    float remapped_M = ocio_remap_M_fwd0(M, gamutBoundaryM, reachBoundaryM);
    float remapped_J = J_intersect_source + remapped_M * gamut_slope;
    return float3(remapped_J, remapped_M, h);
  }
}

// Declaration of the OCIO shader function

float4 OCIOTransform(float4 inPixel)
{
  float4 outColor = inPixel;
  
  // Add Range processing
  
  {
    outColor.rgb = max(float3(0., 0., 0.), outColor.rgb);
    outColor.rgb = min(float3(4096., 4096., 4096.), outColor.rgb);
  }
  
  // Add Matrix processing
  
  {
    float4 res = float4(outColor.rgb.r, outColor.rgb.g, outColor.rgb.b, outColor.a);
    float4 tmp = res;
    res = float4x4(0.69545224135745176, 0.044794563372037646, -0.0055258825581135443, 0., 0.14067869647029416, 0.85967111845642163, 0.0040252103059786586, 0., 0.16386906217225403, 0.095534318171540358, 1.0015006722521349, 0., 0., 0., 0., 1.) * tmp;
    outColor.rgb = float3(res.x, res.y, res.z);
    outColor.a = res.w;
  }
  
  // Add FixedFunction 'ACES_OutputTransform20 (Forward)' processing
  
  {
    
    // Add RGB to JMh
    
    float3 JMh;
    float3 Aab;
    {
      {
        float3 lms = float3x3(0.445181042, 0.123734146, 0.0117007261, 0.34964928, 0.613643706, 0.0280607939, -0.00112973328, 0.0563228093, 0.753939092) * outColor.rgb;
        float3 F_L_v = pow(abs(lms), float3(0.419999987, 0.419999987, 0.419999987));
        float3 rgb_a = (sign(lms) * F_L_v) / ( 27.1299992 + F_L_v);
        Aab = float3x3(20.2588081, 15480., 1720., 10.1294041, -16887.2734, 1720., 0.506470203, 1407.27271, -3440.) * rgb_a.rgb;
      }
      {
        if (Aab.r <= 0.0)
        {
          JMh.rgb = float3(0., 0., 0.);
        }
        else
        {
          float J = 100. * pow(Aab.r, 1.13705599);
          float M = (J == 0.0) ? 0.0 : sqrt(Aab.g * Aab.g + Aab.b * Aab.b);
          float h = (Aab.g == 0.0) ? 0.0 : atan2(Aab.b, Aab.g) * 57.29577951308238;
          h = h - floor(h / 360.0) * 360.0;
          h = (h < 0.0) ? h + 360.0 : h;
          JMh.rgb = float3(J, M, h);
        }
      }
      outColor.rgb = JMh;
    }
    float h_rad = outColor.b * 0.0174532924;
    float cos_hr = cos(h_rad);
    float sin_hr = sin(h_rad);
    
    // Add ToneScale and ChromaCompress (fwd)
    
    float J_ts = ocio_tonescale_fwd0(outColor.r);
    // Sample tables (fwd)
    float reachMaxM = ocio_reach_m_table_0_sample(outColor.b);
    
    {
      float J = outColor.r;
      float M = outColor.g;
      float h = outColor.b;
      float M_cp = M;
      if (M != 0.0)
      {
        float nJ = J_ts / 283.249878;
        float snJ = max(0.0, 1.0 - nJ);
        float Mnorm;
        {
          float cos_hr2 = 2.0 * cos_hr * cos_hr - 1.0;
          float sin_hr2 = 2.0 * cos_hr * sin_hr;
          float cos_hr3 = 4.0 * cos_hr * cos_hr * cos_hr - 3.0 * cos_hr;
          float sin_hr3 = 3.0 * sin_hr - 4.0 * sin_hr * sin_hr * sin_hr;
          float3 cosines = float3(cos_hr, cos_hr2, cos_hr3);
          float3 cosine_weights = float3(28.177105004310604, 40.918782982468606, 19.588056175708772);
          float3 sines = float3(sin_hr, sin_hr2, sin_hr3);
          float3 sine_weights = float3(36.435131137728689, -15.832440585136412, 22.842479106426239);
          Mnorm = dot(cosines, cosine_weights) + dot(sines, sine_weights) + 191.63428819274904;
        }
        float limit = pow(nJ, 0.879464149) * reachMaxM / Mnorm;
        M_cp = M * pow(J_ts / J, 0.879464149);
        M_cp = M_cp / Mnorm;
        M_cp = limit - ocio_toe_fwd0(limit - M_cp, limit - 0.001, snJ * 0.402999997, sqrt(nJ * nJ + 0.000500000024));
        M_cp = ocio_toe_fwd0(M_cp, limit, nJ * 10.3199997, snJ);
        M_cp = M_cp * Mnorm;
      }
      outColor.rgb = float3(J_ts, M_cp, h);
    }
    
    // Add GamutCompress (fwd)
    
    {
      float3 JMGcusp = ocio_gamut_cusp_table_0_sample(outColor.b);
      outColor.rgb = ocio_gamut_compress0(outColor.rgb, outColor.r, JMGcusp, reachMaxM);
    }
    
    // Add JMh to RGB
    
    {
      float3 JMh = outColor.rgb;
      float3 Aab;
      {
        Aab.r = pow(JMh.r * 0.00999999978, 0.879464149);
        Aab.g = JMh.g * cos_hr;
        Aab.b = JMh.g * sin_hr;
      }
      {
        float3 rgb_a = float3x3(0.0323680304, 0.0323680304, 0.0323680304, 2.07657631e-05, -4.10250432e-05, -1.01296409e-05, 1.3260621e-05, -1.20174373e-05, -0.000290076074) * Aab.rgb;
        float3 rgb_a_lim = min( abs(rgb_a), float3(0.99000001, 0.99000001, 0.99000001) );
        float3 lms = sign(rgb_a) * pow( 27.1299992 * rgb_a_lim / (1.0f - rgb_a_lim), float3(2.38095236, 2.38095236, 2.38095236));
        JMh.rgb = float3x3(5.86586046, -1.17879081, 0.0301606376, -4.4882164, 2.81135964, -0.16902554, -0.117723353, -0.372647762, 1.39878595) * lms;
      }
      outColor.rgb = JMh;
    }
  }
  
  // Add Range processing
  
  {
    outColor.rgb = max(float3(0., 0., 0.), outColor.rgb);
    outColor.rgb = min(float3(10., 10., 10.), outColor.rgb);
  }
  
  // Add Gamma 'monCurveMirrorRev' processing
  
  {
    float4 breakPnt = float4(0.00303993467, 0.00303993467, 0.00303993467, 1.);
    float4 slope = float4(12.9232101, 12.9232101, 12.9232101, 1.);
    float4 scale = float4(1.05499995, 1.05499995, 1.05499995, 1.00000095);
    float4 offset = float4(0.0549999997, 0.0549999997, 0.0549999997, 9.99999997e-07);
    float4 gamma = float4(0.416666657, 0.416666657, 0.416666657, 0.999998987);
    float4 signcol = sign(outColor);;
    outColor = abs( outColor );
    float4 isAboveBreak = float4((outColor[0] > breakPnt[0]) ? 1.0 : 0.0, (outColor[1] > breakPnt[1]) ? 1.0 : 0.0, (outColor[2] > breakPnt[2]) ? 1.0 : 0.0, (outColor[3] > breakPnt[3]) ? 1.0 : 0.0);
    float4 linSeg = outColor * slope;
    float4 powSeg = pow( outColor, gamma ) * scale - offset;
    float4 res = isAboveBreak * powSeg + ( float4(1., 1., 1., 1.) - isAboveBreak ) * linSeg;
    res = signcol * res;
    outColor.rgb = float3(res.x, res.y, res.z);
    outColor.a = res.w;
  }

  return outColor;
}

// Close class wrapper


};
float4 OCIOTransform(
  texture1d<float> ocio_reach_m_table_0
  , sampler ocio_reach_m_table_0Sampler
  , texture1d<float> ocio_gamut_cusp_table_0
  , sampler ocio_gamut_cusp_table_0Sampler
  , float4 inPixel)
{
  return ocioOCIOTransform(
    ocio_reach_m_table_0
    , ocio_reach_m_table_0Sampler
    , ocio_gamut_cusp_table_0
    , ocio_gamut_cusp_table_0Sampler
  ).OCIOTransform(inPixel);
}
